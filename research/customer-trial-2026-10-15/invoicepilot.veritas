      {
        "capability": "signing",
        "allow": true,
        "approval_required": false,
        "max_calls": 10,
        "max_amount": null,
        "asset": ""
      }
    ]
  },
  "environment": {
    "python_version": "3.12",
    "network": "deny_all",
    "credential_mode": "none",
    "dependencies": [
