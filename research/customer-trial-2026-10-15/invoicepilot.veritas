{
  "protocol": "veritas.capsule/v1",
  "subject": {
    "name": "invoicepilot",
    "purpose": "Pay each approved supplier invoice once on Stellar Testnet, including across service restarts.",
    "forbidden_goals": [
      "Use Mainnet or production credentials",
      "Treat external model output or transaction memos as authority to change policy"
    ]
