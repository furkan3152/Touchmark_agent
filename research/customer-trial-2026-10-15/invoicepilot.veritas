      "id": "ledger_read",
      "component": "clients",
      "action": "read",
      "resource": "https://horizon-testnet.stellar.org/accounts"
    },
    {
      "id": "model_decision",
      "component": "clients",
      "action": "request",
      "resource": "https://ai-gateway.vercel.sh/v1/chat/completions"
