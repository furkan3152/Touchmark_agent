# Touchmark sample configuration
# The default profile is Testnet; backend does not sign or send any transactions.

# Side-effect API endpoints fail-closed. Use at least 32 random bytes.
ADMIN_API_KEY=
ADMIN_RATE_LIMIT_PER_MINUTE=60
# Public Studio limits are per client address. Set true only behind a reverse proxy
# that overwrites X-Forwarded-For (Vercel is detected automatically).
TRUST_PROXY_HEADERS=false

# testnet | mainnet | offline. For mainnet, ALLOW_MAINNET=true is also required.
STELLAR_NETWORK=testnet
ALLOW_MAINNET=false
# If empty, the official endpoints of the selected network profile will be used.
STELLAR_RPC_URL=
STELLAR_HORIZON_URL=

# Not assumed to have been deployed; ID + RPC state/event verification is required.
AGENT_REGISTRY_CONTRACT_ID=
AUDIT_ESCROW_CONTRACT_ID=
# Stellar Asset Contract ID for the escrow asset (SEP-41).
SAC_CONTRACT_ID=
# UI/log label. If empty, XLM is resolved from the native XLM SAC release manifest;
# if using an issued asset, specify it explicitly (e.g. USDC).
ESCROW_ASSET_CODE=
ENABLE_AUDIT_ESCROW=false
EXTERNAL_SIGNING_REQUIRED=true

# Web auth is independent of the validation core.
SEP10_WEB_AUTH_ENDPOINT=
# SEP-45 is a Draft; provider compliance must be verified before announcing C-account support.
SEP45_WEB_AUTH_ENDPOINT=

# External LLM is opened only with provider + key. Privacy audit also requires opt-in.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=
ALLOW_EXTERNAL_LLM_FOR_PRIVATE_AUDITS=false
# Only enable to send adversarial payloads to an isolated/sandbox endpoint.
ENABLE_ACTIVE_AGENT_PROBES=false

# If empty, the report is written to the local content-addressed store; IPFS success is not asserted.
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# OFAC cache is keyless; if there is no cache, a "clean" result is not produced.
ENABLE_OFAC_SCREENING=true
OFAC_MAX_AGE_HOURS=24
SCREENING_PROVIDER=none
SCREENING_API_KEY=

# Used only in the optional escrow module; core validation fee is 0.
PLATFORM_FEE_BPS=1500
PRICE_BASIC_USDC=2.0
PRICE_DEEP_USDC=25.0
MONITOR_TICK_PRICE_USDC=0.0
SWARM_STAKE_USDC=5.0
AUDITOR_TIMEOUT_SECONDS=30

# Empty uses sqlite:///./data/touchmark.db, or a pre-rename ./data/agentveritas*.db that already exists.
DATABASE_URL=
DATA_DIR=./data
EVENT_DATABASE=./data/stellar-events.db
# Release manifest for ID + pinned WASM + live deploy tx readback proof.
DEPLOYMENT_MANIFEST=./deployments/stellar-testnet.json

# Local ingest is off by default; if enabled, only paths under INGEST_ROOT are read.
INGEST_ROOT=
ALLOW_LOCAL_PATH_INGEST=false
MAX_INGEST_BYTES=8000000

# Optional public AI second opinion; source leaves the server only with explicit consent.
ENABLE_PUBLIC_AI_REVIEW=false
# Never enable operator persistence on ephemeral serverless storage.
STATELESS_STUDIO=false

# Private pilot APIs (distinct credentials; never put these in client bundles).
RUNTIME_API_KEY=
CHECKOUT_QUOTE_SIGNING_KEY=
ENABLE_SANDBOX_RUNTIME=false
AI_REVIEW_API_KEY=
AI_GATEWAY_API_KEY=

# Optional automatic Testnet delivery on a persistent operator host.
# Vercel's stateless entrypoint rejects this local SQLite worker.
ENABLE_OFFICIAL_ORDERS=false
OFFICIAL_ORDERS_DATABASE=./data/official-orders.db
OFFICIAL_ORDERS_STORAGE_DURABLE=false
OFFICIAL_ORDERS_LOCAL_PILOT=false
ENABLE_TESTNET_ORDER_SETTLEMENT=false
OFFICIAL_PROVIDER_SECRET=
OFFICIAL_EVALUATOR_SECRET=
# Private report storage only; full report bytes are not publicly readable.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# The assay book: stamp every demo audit on Stellar testnet (needs DEMO_OPERATOR_SECRET and a
# durable store) and release each report for a testnet payment of ASSAY_PRICE_XLM.
ENABLE_ASSAY_BOOK=false
ASSAY_PRICE_XLM=2
OFFICIAL_REPORT_BASE_URL=

# Model review (Claude, tool-using, grounded in Touchmark evidence). Runs only when a
# reviewer consents to sending source. Store the key in the host secret manager.
# Read public ledger state for supplied addresses (signers, thresholds, SEP-1, SEP-29).
ENABLE_ONCHAIN_VERIFICATION=true
ENABLE_DEEP_REVIEW=false
ANTHROPIC_API_KEY=
# ANTHROPIC_AI_KEY is still read as a fallback for older deployments.
# The public demo runs claude-haiku-5-5 at medium effort for the review and the verifier.
DEEP_REVIEW_MODEL=claude-sonnet-5-5
DEEP_REVIEW_EFFORT=medium
# ledger (file map, investigation, check ledger, challenge, focused file review, coverage) or classic.
DEEP_REVIEW_MODE=ledger
# File map model and effort; an empty model uses DEEP_REVIEW_MODEL.
DEEP_REVIEW_MAP_MODEL=
DEEP_REVIEW_MAP_EFFORT=low
# Local runs only (no request leg): the review stops after this many seconds (30-900).
DEEP_REVIEW_TIMEOUT_SECONDS=240
# Independent re-check of medium-or-higher findings by a separate model call (needs ANTHROPIC_API_KEY).
ENABLE_FINDING_VERIFICATION=true
VERIFIER_MODEL=claude-sonnet-5-5
VERIFIER_EFFORT=medium
# Public demo allowance for the model review (it is paid per audit). Kept in Vercel Blob
# (BLOB_READ_WRITE_TOKEN, private store) so it holds across serverless invocations; the
# daily limit is a hard ceiling. auto = Blob when a token is set, process memory only off
# serverless, none otherwise (the model review is then off and audits run on the rules).
DEEP_REVIEW_LIMIT_STORE=auto
DEEP_REVIEW_CLIENT_HOURLY_LIMIT=5
DEEP_REVIEW_HOURLY_LIMIT=60
DEEP_REVIEW_DAILY_LIMIT=200
# Optional key for hashing client addresses in the allowance store (derived from the Blob token when empty).
DEEP_REVIEW_RATE_SALT=
# Spend caps. On the demo no clock stops a review; these do. Per audit (review and verifier together),
# measured from each response's usage: tokens (input, cache writes, cache reads, output),
# their cost at the prices below, and files read. Across the deployment, per UTC day and on
# top of DEEP_REVIEW_DAILY_LIMIT: a hard cost cap in USD (DEEP_REVIEW_DAILY_COST_USD, claimed
# in 0.25 USD create-only chunks in the Blob store; it can be passed by at most one chunk per
# audit request running when it is reached) and a token budget as a secondary safety net.
# A reached cap ends the review cleanly; the report lists every unread file with the cap.
# Once the daily cost cap is reached no model review starts until the next UTC day (rules
# only). Spend is logged by the server and never shown in a public response.
DEEP_REVIEW_MAX_TOKENS_PER_AUDIT=200000000
DEEP_REVIEW_MAX_COST_USD_PER_AUDIT=30
DEEP_REVIEW_MAX_FILES_PER_AUDIT=400
DEEP_REVIEW_DAILY_COST_USD=100
DEEP_REVIEW_DAILY_TOKEN_BUDGET=600000000
# USD per million tokens; defaults are Claude Sonnet 5.5 prices. The public demo sets Claude Haiku 5.5's
# higher (over 100K-token prompt) tier: 0.5, 2.5, 0.625, 0.05, so its cost counter reads high.
DEEP_REVIEW_PRICE_INPUT_PER_MTOK=2.0
DEEP_REVIEW_PRICE_OUTPUT_PER_MTOK=10.0
DEEP_REVIEW_PRICE_CACHE_WRITE_PER_MTOK=2.5
DEEP_REVIEW_PRICE_CACHE_READ_PER_MTOK=0.2
# A hung model request is abandoned after this many seconds and retried (with backoff).
DEEP_REVIEW_CALL_TIMEOUT_SECONDS=120
DEEP_REVIEW_CALL_RETRIES=2
DEEP_REVIEW_FILES_PER_PASS=10
# Serverless: an audit runs as a job of request legs; each stops starting model calls this
# long after it began (inside vercel.json's 300 s) and the page continues it. Jobs expire.
DEMO_LEG_SECONDS=240
DEMO_JOB_TTL_HOURS=24
# Testnet key that admins the demo registry and acts as its validator (scripts/deploy_demo_testnet.py).
DEMO_OPERATOR_SECRET=
